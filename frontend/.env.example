# Supabase project credentials
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Authoritative multiplayer game server (Cloudflare Worker).
# Use this URL while running `npm run dev` in game-server/ locally.
VITE_GAME_SERVER_URL=http://127.0.0.1:8787
# For a hosted environment, replace it with your own deployed Worker URL.
