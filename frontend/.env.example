# Public Supabase browser configuration (never use the service-role key here).
# On Windows, Start-Rune-Riot.bat creates the ignored .env.local automatically
# from the existing public values in game-server/wrangler.toml.
# For another project, get these from its Supabase API settings and enable
# anonymous sign-ins before starting Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Authoritative multiplayer game server (Cloudflare Worker).
# Use this URL while running `npm run dev` in game-server/ locally.
VITE_GAME_SERVER_URL=http://127.0.0.1:8787
# For a hosted environment, replace it with your own deployed Worker URL.
